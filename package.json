{
  "name": "floppy-grid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && vite build --config vite.server.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server-dist/index.mjs",
    "dev:server": "vite build --config vite.server.config.ts && node --env-file=.env.local server-dist/index.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
